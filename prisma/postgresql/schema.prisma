generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id         String     @id @default(cuid())
  waId       String     @unique
  language   String     @default("pt-BR")
  state      String     @default("greeting")
  consentAt  DateTime?
  intakeJson String     @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  messages   Message[]
  matters    Matter[]
  documents  Document[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  type           String
  body           String?
  mediaId        String?
  mimeType       String?
  waMessageId    String?      @unique
  createdAt      DateTime     @default(now())
}

model Matter {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String       @default("open")
  intakeJson     String       @default("{}")
  lawyerNotes    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Document {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMediaId      String       @unique
  mimeType       String
  filename       String?
  storagePath    String?
  extractedText  String?
  reviewJson     String?
  createdAt      DateTime     @default(now())
}
