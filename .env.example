# SQLite for local development (no Docker required).
# Retention: delete prisma/dev.db and data/media to purge client PII.
# Production: switch Prisma provider to postgresql and point this at Postgres.
DATABASE_URL="file:./prisma/dev.db"

# Lawyer inbox (change in any real deployment)
LAWYER_PASSWORD="troque-esta-senha"

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN="change-me-verify-token"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v21.0"
WHATSAPP_MAX_MEDIA_BYTES="10485760"

# Optional. Without this key, intake/review use heuristics so local tests still run.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Claude.ai (Max): this project will expose a protected remote MCP connector after
# deployment. Do not put a Claude.ai password or session cookie here.
# The connector uses OAuth and needs its public HTTPS base URL at deployment time.
APP_URL="http://localhost:3000"
